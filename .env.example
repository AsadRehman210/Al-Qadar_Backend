# MongoDB connection string
DB_ADDRESS=mongodb://localhost:27017/genaric_code_auth

# Server
PORT=3001
PRODUCTION=FALSE

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://superadmin.example.com,https://admin.example.com
# Leave unset in local dev to reflect any request origin.
ALLOWED_ORIGINS=

# JWT
TOKEN_KEY=replace-with-a-long-random-secret
TOKEN_TIME=1d

# Used to build the reset-password link in emails (see helper-function.ts)
FRONT_END_URL=http://localhost:5173

# Gmail SMTP used for password-reset emails (see sendEmail in helper-function.ts)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# One-time Super Admin seed (used only by `yarn seed:super-admin`)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@alqadar.com
SUPER_ADMIN_PASSWORD=change-this-before-seeding

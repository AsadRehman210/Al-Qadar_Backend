    {
      "name": "08 - Loan",
      "item": [
        {
          "name": "Apply Loan (HR-created -> starts Pending)",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "const res = pm.response.json();",
            "if (res && res.result && res.result.id) { pm.environment.set('loanId', res.result.id); }"
          ]}}],
          "request": {
            "method": "POST",
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{adminToken}}","type":"string"}]},
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"employeeId\": \"{{employeeId}}\",\n  \"loanType\": \"EMI Loan\",\n  \"loanPurpose\": \"Personal\",\n  \"loanAmount\": 60000,\n  \"interestPercent\": 5,\n  \"numberOfInstallments\": 6,\n  \"appliedVia\": \"hr\",\n  \"guarantor\": {\"name\": \"Rohit Verma\", \"contact\": \"+91-9998887777\", \"address\": \"Mumbai\"}\n}","options":{"raw":{"language":"json"}}},
            "url": {"raw":"{{baseUrl}}/loan","host":["{{baseUrl}}"],"path":["loan"]}
          }
        },
        {
          "name": "Apply Loan (Self-Service -> starts Pending Manager)",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "const res = pm.response.json();",
            "if (res && res.result && res.result.id) { pm.environment.set('loanIdSelfService', res.result.id); }"
          ]}}],
          "request": {
            "method": "POST",
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{adminToken}}","type":"string"}]},
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"employeeId\": \"{{employeeId}}\",\n  \"loanType\": \"Advance Salary\",\n  \"loanPurpose\": \"Medical\",\n  \"loanAmount\": 15000,\n  \"interestPercent\": 0,\n  \"numberOfInstallments\": 3,\n  \"appliedVia\": \"employee\"\n}","options":{"raw":{"language":"json"}}},
            "url": {"raw":"{{baseUrl}}/loan","host":["{{baseUrl}}"],"path":["loan"]}
          }
        },
        {
          "name": "Manager Approve (self-service loan) -> Pending HR",
          "request": {
            "method": "PATCH",
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{adminToken}}","type":"string"}]},
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"comments\": \"Approved by manager\"\n}","options":{"raw":{"language":"json"}}},
            "url": {"raw":"{{baseUrl}}/loan/{{loanIdSelfService}}/manager-approve","host":["{{baseUrl}}"],"path":["loan","{{loanIdSelfService}}","manager-approve"]}
          }
        },
        {
          "name": "[Alt] Manager Reject (do not run right after Manager Approve above)",
          "request": {
            "method": "PATCH",
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{adminToken}}","type":"string"}]},
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"rejectionReason\": \"Insufficient justification\"\n}","options":{"raw":{"language":"json"}}},
            "url": {"raw":"{{baseUrl}}/loan/{{loanIdSelfService}}/manager-reject","host":["{{baseUrl}}"],"path":["loan","{{loanIdSelfService}}","manager-reject"]}
          }
        },
        {
          "name": "HR Approve (self-service loan) -> Approved",
          "request": {
            "method": "PATCH",
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{adminToken}}","type":"string"}]},
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"comments\": \"Approved by HR\"\n}","options":{"raw":{"language":"json"}}},
            "url": {"raw":"{{baseUrl}}/loan/{{loanIdSelfService}}/hr-approve","host":["{{baseUrl}}"],"path":["loan","{{loanIdSelfService}}","hr-approve"]}
          }
        },
        {
          "name": "[Alt] HR Reject",
          "request": {
            "method": "PATCH",
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{adminToken}}","type":"string"}]},
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"rejectionReason\": \"Not eligible at this time\"\n}","options":{"raw":{"language":"json"}}},
            "url": {"raw":"{{baseUrl}}/loan/{{loanId}}/hr-reject","host":["{{baseUrl}}"],"path":["loan","{{loanId}}","hr-reject"]}
          }
        },
        {
          "name": "HR Approve (HR-created loan, was already Pending) -> Approved",
          "request": {
            "method": "PATCH",
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{adminToken}}","type":"string"}]},
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"comments\": \"Approved by HR\"\n}","options":{"raw":{"language":"json"}}},
            "url": {"raw":"{{baseUrl}}/loan/{{loanId}}/hr-approve","host":["{{baseUrl}}"],"path":["loan","{{loanId}}","hr-approve"]}
          }
        },
        {
          "name": "Disburse Loan -> Ongoing + posts Finance journal entry",
          "request": {
            "method": "PATCH",
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{adminToken}}","type":"string"}]},
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}},
            "url": {"raw":"{{baseUrl}}/loan/{{loanId}}/disburse","host":["{{baseUrl}}"],"path":["loan","{{loanId}}","disburse"]}
          }
        },
        {
          "name": "Record Repayment (Installment 1) -> posts reverse Finance entry",
          "request": {
            "method": "PATCH",
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{adminToken}}","type":"string"}]},

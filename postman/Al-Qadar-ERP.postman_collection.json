{
  "info": {
    "name": "Al-Qadar ERP API",
    "description": "End-to-end test collection for the Al-Qadar ERP backend (Super Admin / Admin / Merchant, Employee Management, Loan, Expense, Provident Fund, Attendance, Finance). Import this file plus the companion environment file, select the environment, run `yarn seed:super-admin` once against a running MongoDB, then run this collection top-to-bottom via the Collection Runner. Requests are ordered so each one's output (ids/tokens) feeds the next via environment variables — no manual copy-pasting needed. The 'Cleanup' folder at the end is NOT part of the main flow — run it manually only if you want to exercise the delete/soft-delete endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Auth",
      "item": [
        {
          "name": "Login - Super Admin",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "const res = pm.response.json();",
            "pm.test('login succeeded', () => pm.expect(res.success).to.eql(true));",
            "if (res && res.result && res.result.token) { pm.environment.set('superAdminToken', res.result.token); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\",\n  \"portal\": \"super_admin\"\n}","options":{"raw":{"language":"json"}}},
            "url": {"raw":"{{baseUrl}}/auth/login","host":["{{baseUrl}}"],"path":["auth","login"]}
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{superAdminToken}}","type":"string"}]},
            "header": [],
            "url": {"raw":"{{baseUrl}}/auth/logout","host":["{{baseUrl}}"],"path":["auth","logout"]}
          }
        }
      ]
    },
